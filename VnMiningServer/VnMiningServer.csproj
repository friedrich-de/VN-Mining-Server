<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VnMiningServer</RootNamespace>
    <AssemblyName>VnMiningServer</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The server speaks English only, and culture data would double the container's size. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- ASP.NET Core only finds controllers that are public, in a program as much as in a library. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(SqliteVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yomitan's rules for undoing Japanese inflections, as the Hoshidicts language pack writes them (Dictionary/Japanese/SOURCES.md). -->
    <EmbeddedResource Include="Dictionary\Japanese\transforms.json" LogicalName="dictionary/ja/transforms.json" />
    <!-- The page, as "npm run build" in web/ leaves it in web/dist. Without that folder the server still
         builds, and says on its address that it holds no page. -->
    <EmbeddedResource Include="..\web\dist\**\*" LogicalName="page/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VnMiningServer.Tests" />
  </ItemGroup>

</Project>
